include_guard(GLOBAL)
set(CHAMPIONS_LEVEL_FLOW_ROOT "${CMAKE_CURRENT_LIST_DIR}")
if(TARGET champions-archive)
  set(level_flow_archive_target champions-archive)
elseif(TARGET champions-archive-binding-core)
  set(level_flow_archive_target champions-archive-binding-core)
else()
  message(FATAL_ERROR "Level flow requires the existing native or Godot archive target")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/arena_modes_library.cmake")
add_library(champions-level-flow "${CHAMPIONS_LEVEL_FLOW_ROOT}/src/level_flow.cpp" "${CHAMPIONS_LEVEL_FLOW_ROOT}/src/level_flow_loader.cpp")
target_include_directories(champions-level-flow PUBLIC "${CHAMPIONS_LEVEL_FLOW_ROOT}/include")
target_link_libraries(champions-level-flow PUBLIC champions-world-queries champions-objects champions-arena-modes ${level_flow_archive_target})
add_library(champions-session-level-flow "${CHAMPIONS_LEVEL_FLOW_ROOT}/src/session_level_flow.cpp")
target_include_directories(champions-session-level-flow PUBLIC "${CHAMPIONS_LEVEL_FLOW_ROOT}/include")
target_link_libraries(champions-session-level-flow PUBLIC champions-level-flow)
foreach(target champions-level-flow champions-session-level-flow)
  set_target_properties(${target} PROPERTIES POSITION_INDEPENDENT_CODE ON)
  if(MSVC)
    target_compile_options(${target} PRIVATE /W4 /utf-8 /fp:strict)
  else()
    target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic -fno-fast-math -ffp-contract=off)
  endif()
endforeach()
if(BUILD_TESTING)
  add_executable(champions-level-flow-tests "${CHAMPIONS_LEVEL_FLOW_ROOT}/tests/level_flow_tests.cpp")
  target_link_libraries(champions-level-flow-tests PRIVATE champions-session-level-flow champions-objects champions-terrain-file)
  # Keep the large authored cases separate. Apple Clang 21 spent over 26
  # minutes in MachineCSE for this test driver at -O3. Libraries retain their
  # normal Release optimization; only the test driver's inlining is disabled.
  if(NOT MSVC AND CMAKE_CXX_COMPILER_ID MATCHES "Clang")
    target_compile_options(champions-level-flow-tests PRIVATE "$<$<CONFIG:Release>:-fno-inline-functions>")
  endif()
  add_test(NAME level-flow-exact COMMAND champions-level-flow-tests)
endif()

# Optional external source, compiled in this worktree without copying/editing it.
# After merging creature-water-2, the existing target takes precedence.
set(CHAMPIONS_LEVEL_FLOW_WATER_ROOT "" CACHE PATH "Read-only creature-water-2 worktree for adapter validation")
if(TARGET champions-creature-water OR CHAMPIONS_LEVEL_FLOW_WATER_ROOT)
  if(NOT TARGET champions-creature-water)
    add_library(champions-level-flow-water-service
      "${CHAMPIONS_LEVEL_FLOW_WATER_ROOT}/native/src/creature_water.cpp")
    target_include_directories(champions-level-flow-water-service PUBLIC
      "${CHAMPIONS_LEVEL_FLOW_WATER_ROOT}/native/include")
    target_link_libraries(champions-level-flow-water-service PUBLIC champions-creature-movement)
    set(level_flow_water_target champions-level-flow-water-service)
  else()
    set(level_flow_water_target champions-creature-water)
  endif()
  if(BUILD_TESTING)
    add_executable(champions-level-flow-water-tests "${CHAMPIONS_LEVEL_FLOW_ROOT}/tests/level_flow_water_tests.cpp")
    target_link_libraries(champions-level-flow-water-tests PRIVATE
      champions-level-flow ${level_flow_water_target})
    add_test(NAME level-flow-water-adapter COMMAND champions-level-flow-water-tests)
  endif()
endif()

# Closed synthetic host: real loader/Session adapter, not a generic engine host.
add_library(champions-level-play "${CHAMPIONS_LEVEL_FLOW_ROOT}/src/level_play.cpp")
target_include_directories(champions-level-play PUBLIC "${CHAMPIONS_LEVEL_FLOW_ROOT}/include")
target_link_libraries(champions-level-play PUBLIC champions-session-level-flow champions-session-control champions-terrain-file champions-creature-water)
set_target_properties(champions-level-play PROPERTIES POSITION_INDEPENDENT_CODE ON)
if(MSVC)
  target_compile_options(champions-level-play PRIVATE /W4 /utf-8 /fp:strict)
else()
  target_compile_options(champions-level-play PRIVATE -Wall -Wextra -Wpedantic -fno-fast-math -ffp-contract=off)
endif()
if(BUILD_TESTING)
  add_executable(champions-level-play-tests "${CHAMPIONS_LEVEL_FLOW_ROOT}/tests/level_play_tests.cpp")
  target_link_libraries(champions-level-play-tests PRIVATE champions-level-play)
  add_test(NAME level-play COMMAND champions-level-play-tests)
endif()
# Counts-only measurement. Not a CTest: it needs a private disc and prints no names.
add_executable(champions-level-spawn-measure "${CHAMPIONS_LEVEL_FLOW_ROOT}/tools/level_spawn_measure.cpp")
target_link_libraries(champions-level-spawn-measure PRIVATE champions-level-flow champions-objects champions-terrain-file)
if(MSVC)
  target_compile_options(champions-level-spawn-measure PRIVATE /W4 /utf-8 /fp:strict)
else()
  target_compile_options(champions-level-spawn-measure PRIVATE -Wall -Wextra -Wpedantic -fno-fast-math -ffp-contract=off)
endif()
