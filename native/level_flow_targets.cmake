add_library(champions-level-flow src/level_flow.cpp src/level_flow_loader.cpp)
target_include_directories(champions-level-flow PUBLIC include)
target_link_libraries(champions-level-flow PUBLIC champions-world-queries champions-archive)
add_library(champions-session-level-flow src/session_level_flow.cpp)
target_include_directories(champions-session-level-flow PUBLIC include)
