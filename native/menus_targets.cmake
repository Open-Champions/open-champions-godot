add_library(champions-menus "${CMAKE_CURRENT_LIST_DIR}/src/menus.cpp")
target_include_directories(champions-menus PUBLIC "${CMAKE_CURRENT_LIST_DIR}/include")
target_link_libraries(champions-menus PUBLIC champions-messages)
set_target_properties(champions-menus PROPERTIES POSITION_INDEPENDENT_CODE ON)
if(MSVC)
    target_compile_options(champions-menus PRIVATE /W4 /utf-8 /fp:strict)
else()
    target_compile_options(champions-menus PRIVATE -Wall -Wextra -Wpedantic -fno-fast-math -ffp-contract=off)
endif()
if(BUILD_TESTING AND CMAKE_CURRENT_SOURCE_DIR STREQUAL CMAKE_CURRENT_LIST_DIR)
    add_executable(champions-menus-tests "${CMAKE_CURRENT_LIST_DIR}/tests/menus_tests.cpp")
    target_link_libraries(champions-menus-tests PRIVATE champions-menus)
    add_test(NAME menus-exact COMMAND champions-menus-tests)
endif()
