add_library(champions-ui-font src/ui_font.cpp src/ui_art_shape.cpp src/ui_font_page.cpp)
target_link_libraries(champions-ui-font PUBLIC champions-texture)
target_include_directories(champions-ui-font PUBLIC include)
if(MSVC)
    target_compile_options(champions-ui-font PRIVATE /W4 /utf-8)
else()
    target_compile_options(champions-ui-font PRIVATE -Wall -Wextra -Wpedantic)
endif()
if(BUILD_TESTING)
    foreach(unit ui_font ui_art_shape)
        add_executable(champions-${unit}-tests tests/${unit}_tests.cpp)
        target_link_libraries(champions-${unit}-tests PRIVATE champions-ui-font)
        target_compile_definitions(champions-${unit}-tests PRIVATE UI_FONT_SHAPE_VECTORS="${CMAKE_CURRENT_SOURCE_DIR}/tests/ui_font_shape_vectors.txt")
        add_test(NAME ${unit} COMMAND champions-${unit}-tests)
    endforeach()
endif()
