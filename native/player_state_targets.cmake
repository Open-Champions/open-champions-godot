include_guard(GLOBAL)
set(CHAMPIONS_PLAYER_STATE_ROOT "${CMAKE_CURRENT_LIST_DIR}")
add_library(champions-player-state "${CHAMPIONS_PLAYER_STATE_ROOT}/src/player_state.cpp")
target_include_directories(champions-player-state PUBLIC "${CHAMPIONS_PLAYER_STATE_ROOT}/include")
target_link_libraries(champions-player-state PUBLIC champions-combat champions-arena-modes)
set_target_properties(champions-player-state PROPERTIES POSITION_INDEPENDENT_CODE ON)
if(MSVC)
  target_compile_options(champions-player-state PRIVATE /W4 /utf-8 /fp:strict)
else()
  target_compile_options(champions-player-state PRIVATE -Wall -Wextra -Wpedantic -fno-fast-math -ffp-contract=off)
endif()
if(BUILD_TESTING AND TARGET champions-archive)
  add_executable(champions-player-state-tests "${CHAMPIONS_PLAYER_STATE_ROOT}/tests/player_state_tests.cpp")
  target_link_libraries(champions-player-state-tests PRIVATE champions-player-state)
  add_test(NAME player-state COMMAND champions-player-state-tests)
endif()
