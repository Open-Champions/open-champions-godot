# Created-character appearance contracts (docs/CHAR_APPEARANCE.md). Godot-free;
# included by the native tree and by the GDExtension after simulation_targets.
include_guard(GLOBAL)
set(CHAMPIONS_CHAR_APPEARANCE_ROOT "${CMAKE_CURRENT_LIST_DIR}")
add_library(champions-char-appearance "${CHAMPIONS_CHAR_APPEARANCE_ROOT}/src/char_appearance.cpp")
target_include_directories(champions-char-appearance PUBLIC "${CHAMPIONS_CHAR_APPEARANCE_ROOT}/include")
target_link_libraries(champions-char-appearance PUBLIC champions-animation-clock champions-core)
set_target_properties(champions-char-appearance PROPERTIES POSITION_INDEPENDENT_CODE ON)
if(MSVC)
  target_compile_options(champions-char-appearance PRIVATE /W4 /utf-8 /fp:strict)
else()
  target_compile_options(champions-char-appearance PRIVATE -Wall -Wextra -Wpedantic -fno-fast-math -ffp-contract=off)
endif()
if(BUILD_TESTING AND NOT CHAMPIONS_CHAR_APPEARANCE_NO_TESTS)
  add_executable(champions-char-appearance-tests "${CHAMPIONS_CHAR_APPEARANCE_ROOT}/tests/char_appearance_tests.cpp")
  target_link_libraries(champions-char-appearance-tests PRIVATE champions-char-appearance)
  if(MSVC)
    target_compile_options(champions-char-appearance-tests PRIVATE /W4 /utf-8 /fp:strict)
  else()
    target_compile_options(champions-char-appearance-tests PRIVATE -Wall -Wextra -Wpedantic -fno-fast-math -ffp-contract=off)
  endif()
  add_test(NAME char-appearance COMMAND champions-char-appearance-tests)
endif()
