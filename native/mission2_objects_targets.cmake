# Mission 2 objects. The session does not link this: the level load stops
# before these objects are reached. The library has no other dependency.
if(NOT TARGET champions-mission2-objects)
  add_library(champions-mission2-objects "${CMAKE_CURRENT_LIST_DIR}/src/mission2_objects.cpp")
  target_include_directories(champions-mission2-objects PUBLIC "${CMAKE_CURRENT_LIST_DIR}/include")
  set_target_properties(champions-mission2-objects PROPERTIES POSITION_INDEPENDENT_CODE ON)
  if(MSVC)
    target_compile_options(champions-mission2-objects PRIVATE /W4 /utf-8 /fp:strict)
  else()
    target_compile_options(champions-mission2-objects PRIVATE -Wall -Wextra -Wpedantic -fno-fast-math -ffp-contract=off)
  endif()
endif()
if(BUILD_TESTING AND NOT TARGET champions-mission2-objects-tests)
  add_executable(champions-mission2-objects-tests "${CMAKE_CURRENT_LIST_DIR}/tests/mission2_objects_tests.cpp")
  target_link_libraries(champions-mission2-objects-tests PRIVATE champions-mission2-objects)
  if(MSVC)
    target_compile_options(champions-mission2-objects-tests PRIVATE /W4 /utf-8 /fp:strict)
  else()
    target_compile_options(champions-mission2-objects-tests PRIVATE -Wall -Wextra -Wpedantic -fno-fast-math -ffp-contract=off)
  endif()
  add_test(NAME mission2-objects COMMAND champions-mission2-objects-tests)
endif()
