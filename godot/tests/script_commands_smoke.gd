extends SceneTree

# The level-script opt-in is off until a caller passes an image. An empty
# image is refused and does not change the play observation.
var failures := 0

# Case tick_counter of native/tests/vectors/script_host.txt: an image built by
# research 9649e6b ref_amx.build_image (tools/generate_script_host_vectors.py).
# start queues "tick"; tick runs addv("n", 1) and queues itself again. In the
# reference n equals the number of Script tasks after the load, one per
# simulated ready tick (research docs/script.md 2.4).
const TICK_COUNTER := ""


func check(ok: bool, why: String) -> void:
	if not ok:
		failures += 1
		push_error(why)

func _initialize() -> void:
	call_deferred("run")

func run() -> void:
	check(ClassDB.class_has_method("ChampionsSessionController", "enable_level_script"), "level script method is bound")
	var controller = ClassDB.instantiate("ChampionsSessionController")
	check(controller != null, "session controller exists")
	if controller == null:
		print("script commands smoke FAIL")
		quit(1)
		return
	var caps: Dictionary = controller.get_play_capabilities()
	check(caps.get("level_script_available", false) == true, "level script is available")
	check(caps.get("level_script_enabled", true) == false, "level script starts disabled")
	var before: Dictionary = controller.get_observation()
	var refused: Dictionary = controller.enable_level_script(PackedByteArray(), PackedByteArray())
	check(refused.get("ok", true) == false, "an empty script image is refused")
	check(controller.get_observation() == before, "a refused script leaves the observation unchanged")
	var started: Dictionary = controller.start_play_session()
	check(started.get("ok", false), "play still starts")
	var playing: Dictionary = controller.get_observation()
	var again: Dictionary = controller.enable_level_script(PackedByteArray(), PackedByteArray())
	check(again.get("ok", true) == false, "an empty script is refused during play")
	check(controller.get_observation() == playing, "the refusal does not advance play")
	controller.advance(0)
	check(controller.get_observation().get("ok", false), "a tick without a script still advances")
	check(controller.script_command_counts().get("ok", true) == false, "counts stay absent until a script is enabled")
	run_tick_counter(controller)
	# A fresh session: its first submission simulates no ready tick.
	var fresh = ClassDB.instantiate("ChampionsSessionController")
	check(fresh.start_play_session().get("ok", false), "a second play session starts")
	run_tick_counter(fresh)
	check_trigger_property(fresh)
	var silent: Dictionary = fresh.enable_level_script(TICK_COUNTER.hex_decode(), PackedByteArray(), false, {}, 0)
	check(silent.get("ok", false) and int(silent.get("music_volume", -1)) == 0, "options-file zero reaches the script host")
	var loud: Dictionary = fresh.enable_level_script(TICK_COUNTER.hex_decode(), PackedByteArray(), false, {}, 0x3fc00000)
	check(loud.get("ok", false) and int(loud.get("music_volume", -1)) == 0x3fc00000, "the unclamped options word reaches the script host")
	print("script commands smoke ", "PASS" if failures == 0 else "FAIL")
	quit(0 if failures == 0 else 1)

func trigger_objects(position: Vector3, properties: Array[String]) -> PackedByteArray:
	var size := 24 + 4 * properties.size()
	var objects := PackedByteArray()
	objects.resize(8 + size)
	objects.encode_u16(0, 1)
	objects.encode_u32(4, objects.size())
	objects.encode_u16(12, size)
	objects.encode_float(16, position.x - 100.0)
	objects.encode_float(20, position.y + 100.0)
	objects.encode_float(24, position.z)
	var strings := PackedByteArray([0])
	objects.encode_u32(8, strings.size())
	strings.append_array("Trigger".to_utf8_buffer())
	strings.append(0)
	for i in range(properties.size()):
		objects.encode_u32(28 + 4 * i, strings.size())
		strings.append_array(properties[i].to_utf8_buffer())
		strings.append(0)
	objects.append_array(strings)
	return objects

func check_trigger_property(controller) -> void:
	var position: Vector3 = controller.get_observation().get("position", Vector3.ZERO)
	var both := trigger_objects(position, ["script=absent", "t=tick", "w=200", "h=200"])
	check(controller.enable_level_script(TICK_COUNTER.hex_decode(), both).get("ok", false), "synthetic Trigger with both properties loads")
	for i in range(32): controller.advance(0)
	var status: Dictionary = controller.script_trigger_status()
	check(int(status.get("dispatches", 0)) > 0 and int(status.get("missing", -1)) == 0,
		"walk-in dispatch uses documented t when script alias is also present")
	var alias_only := trigger_objects(position, ["script=tick", "w=200", "h=200"])
	check(controller.enable_level_script(TICK_COUNTER.hex_decode(), alias_only).get("ok", false), "synthetic alias-only Trigger loads")
	var targets: Array = controller.script_exit_targets()
	check(targets.size() == 1 and not targets[0].get("walk_in", true), "missing t refuses automatic dispatch")

func run_tick_counter(controller) -> void:
	var ticks_before := int(controller.get_observation().get("ready_ticks", -1))
	var enabled: Dictionary = controller.enable_level_script(TICK_COUNTER.hex_decode(), PackedByteArray())
	check(enabled.get("ok", false), "the reference tick counter image is accepted")
	check(int(enabled.get("music_volume", -1)) == 0x3f000000, "script host receives the documented default")
	var calls := 0
	for i in range(6):
		controller.advance(0)
		calls += 1
	var ticks := int(controller.get_observation().get("ready_ticks", -1)) - ticks_before
	var counts: Dictionary = controller.script_command_counts()
	var executed: Dictionary = counts.get("executed", {})
	print("script tick counter: advance calls ", calls, " ready ticks ", ticks, " addv ", int(executed.get("addv", 0)))
	check(ticks > 0, "the session simulated ready ticks")
	check(int(executed.get("addv", 0)) == ticks, "one Script task per simulated ready tick, not per advance call")
	check(int(counts.get("faults", -1)) == 0 and int(counts.get("refusal_stops", -1)) == 0, "the tick counter runs without a fault or a refusal stop")
