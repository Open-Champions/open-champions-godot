extends "res://tests/playable_wave_smoke_combat.gd"

# Retain the long-play/save/fight checks, then explicitly select the closed
# two-level policy, saved to disk as a fixture continuation (review finding 2).
func continuation_cases() -> void:
	await super.continuation_cases()
	var controller = scene.controller
	var before: Dictionary = controller.get_observation()
	check(not controller.start_play_session(true, true).ok and controller.get_observation() == before, "mutually exclusive fixtures refuse atomically")
	scene.return_to_selection()
	scene.level_choice.button_pressed = true
	scene.actions.play.pressed.emit()
	check(scene.raw_observation.get("level_enabled", false), "scene opts into real native level Session adapter")
	if not scene.raw_observation.get("level_enabled", false): return
	check(scene.raw_observation.level_policy == "rta-level-fixture-v1", "versioned fixture policy")
	check(scene.raw_observation.facing_raw == 1769, "shared facing draw is not shifted twice")
	check(scene.raw_observation.level_name == "aa" and scene.raw_observation.gate_contact, "native start marker places player on authored gate footprint")
	check(scene.raw_observation.position_raw == scene.raw_observation.level_spawn_raw, "native resolved marker position reaches scene")
	check("fixture continuation disk saves" in scene.capability_label.text, "level capability text names its save format")
	check(scene.save_methods == ["save_file"], "the level fixture advertises the fixture continuation")
	await capture("level-01-on-gate-aa")
	scene.resume_session()
	before = controller.get_observation()
	for command in [1, 16, 31]:
		check(not controller.advance(command).ok and controller.get_observation() == before, "level fixture refuses unsupported commands without mutation")
	for method in ["set_recovery_test", "set_facing_test", "set_animation_cache_test"]:
		check(not controller.call(method, true).ok and controller.get_observation() == before, "level fixture refuses " + method)
	check(not controller.level_gate_confirm("aab").ok, "gate confirmation requires open menu")
	check(not controller.level_request("unknown").ok, "unknown fixture destination refuses")
	scene.advance_step()
	check(scene.raw_observation.ready_ticks == 0, "no-ready submission does not advance level flow")
	for i in range(15): scene.advance_step()
	check(scene.raw_observation.level_trigger_inside, "native 15-tick trigger poll records entry")
	scene.actions.gate_open.pressed.emit()
	before = controller.get_observation()
	for i in range(3): scene.advance_step()
	check(controller.get_observation() == before and scene.raw_observation.gate_menu_open, "gate menu pauses authoritative clock")
	await capture("level-02-gate-menu")
	scene.resume_session() # Clears possible focus pause; gate menu remains native-paused.
	scene.actions.gate_travel.pressed.emit()
	check(not scene.raw_observation.paused and scene.raw_observation.gate_travel_ticks == 1, "confirm begins travel at native tick one")
	var start: int = scene.raw_observation.ready_ticks
	for i in range(179):
		scene.advance_step()
		check(scene.raw_observation.level_name == "aa", "no early gate arrival")
	check(scene.raw_observation.gate_travel_ticks == 180, "179 ready ticks remain in source level")
	await capture("level-03-travel-179")
	scene.resume_session()
	scene._observe(controller.advance_time(16667, 0))
	var presentation: Dictionary = controller.get_presentation()
	check(presentation.previous_position == presentation.current_position and presentation.current_position == scene.raw_observation.position, "elapsed-time arrival snaps interpolation at level replacement")
	check(scene.raw_observation.ok and scene.raw_observation.level_name == "aab", "180th ready tick loads destination GOB")
	check(scene.raw_observation.ready_ticks == start + 180 and scene.raw_observation.gate_travel_ticks == 181, "exact 180-ready-tick trip")
	check(scene.raw_observation.position_raw == scene.raw_observation.level_spawn_raw and scene.raw_observation.position.z == 0, "native destination marker and real terrain height")
	check(scene.raw_observation.gate_contact and scene.raw_observation.level_saved_count == 1 and not scene.raw_observation.level_trigger_inside, "fresh destination with persisted source level")
	check(scene.level_generation == 2 and scene.gate_display.position.x == 64, "scene publishes destination marker")
	await capture("level-04-arrived-aab")
	scene.resume_session()
	check(not controller.level_request("aa").ok, "return waits for arrival cleanup")
	scene.advance_step()
	check(scene.raw_observation.gate_travel_ticks == 0, "first ready after placement clears travel")
	scene.actions.level_return.pressed.emit()
	scene.advance_step()
	check(scene.raw_observation.ok and scene.raw_observation.level_name == "aa", "return loads saved aa")
	check(scene.raw_observation.level_restored == 1 and scene.raw_observation.level_restored_bytes == 88, "serialized fixture state decoded on re-entry")
	check(scene.raw_observation.level_trigger_inside and scene.raw_observation.level_saved_count == 2, "saved trigger state survives level teardown")
	check(scene.components.art.loaded.size() == 23 and scene.components.animation != null, "real art and animation owners remain present")
	await capture("level-05-restored-aa")
	scene.set_paused(true)
	before = controller.get_observation()
	var level_path := directory.path_join("level-restored.ocplay")
	check(controller.save_file(level_path).ok and FileAccess.file_exists(level_path), "level fixture continuation saved")
	check(controller.get_observation() == before, "saving preserves the level state")
	var prepared: Dictionary = controller.prepare_save_file(level_path)
	var loaded: Dictionary = controller.commit_terrain_file(prepared.get("token", -1))
	for field in ["ready_ticks", "level_name", "level_generation", "level_restored", "level_saved_count", "hp_raw", "position_raw", "paused"]:
		check(loaded.get(field) == before.get(field), "loaded level keeps " + field)
	scene._observe(controller.get_observation())
	print("LEVEL_GATE_RESULT ", JSON.stringify(before))
	await capture("level-06-paused-restored")
	scene.reset_session()
	check(scene.raw_observation.level_name == "aa" and scene.raw_observation.level_restored == 0 and scene.raw_observation.ready_ticks == 0, "reset owns a fresh level fixture")
	scene.level_choice.button_pressed = false
	check(scene.load_session_file(directory.path_join("combined.ocplay")), "ordinary continuation atomically replaces level fixture")
	check(not scene.raw_observation.get("level_enabled", false) and scene.save_methods == ["save_file"], "normal bounded play/save capability returns")
	check(scene.controller == controller and scene.components.art.loaded.size() == 23, "same scene and original-art resources survive level policy switch")
