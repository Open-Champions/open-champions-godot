; Open Champions archive browser — authored UI, no game assets.
config_version=5

[application]
config/name="Open Champions"
run/main_scene="res://scenes/play_flow.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/description="A movement and health test with authored controls, plus archive inspection. No game content is included."

[autoload]
FrameRate="*res://ui/frame_rate.gd"

[display]
window/size/viewport_width=1120
window/size/viewport_height=780
window/size/window_width_override=1120
window/size/window_height_override=780
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=0

[rendering]
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.043, 0.067, 0.071, 1)
